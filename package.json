{
  "name": "movers-packers-dubai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "seo:check": "node scripts/seo-check.mjs",
    "verify": "npm run typecheck && npm run build && npm run seo:check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types --include-runtime=false",
    "db:migrate:local": "wrangler d1 migrations apply ki-movers-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply ki-movers-submissions --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
