{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ki-movers",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  // Static site built into ./dist. Every route is pre-rendered to its own HTML
  // file, so assets are served directly and unknown URLs get a real 404.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Run `npx wrangler d1 create ki-movers-submissions` once, then paste the
  // returned database_id here. The placeholder id is fine for local development.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ki-movers-submissions",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
